<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/cart.css">
</head>
<body>
<%- include('../includes/navigation.ejs') %>

<main>
    <% if (items.length > 0) { %>
        <div class="grid">
            <% for (let item of items) { %>
                <div><%= item.title %></div>
                <div><%= item.price %></div>
                <div><%= item.quantity %></div>
            <% } %>
        </div>
    <% } else { %>
        <h1>Empty cart!</h1>
    <% } %>
</main>
<%- include('../includes/end.ejs') %>